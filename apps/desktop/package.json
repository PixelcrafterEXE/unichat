{
  "name": "@unimsg/desktop",
  "version": "0.0.0-dev",
  "type": "module",
  "main": "out/main/main.js",
  "dependencies": {
    "@signalapp/libsignal-client": "0.106.2",
    "hyperdht": "6.35.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.21",
    "@unimsg/host": "workspace:*"
  },
  "scripts": {
    "setup": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:dir": "electron-vite build && electron-builder --dir",
    "dist:linux": "electron-vite build && electron-builder --linux ${UNICHAT_VERSION:+-c.extraMetadata.version=$UNICHAT_VERSION}",
    "dist:win": "electron-vite build && electron-builder --win",
    "start": "electron-vite preview",
    "typecheck": "tsc -p .",
    "test": "node --import tsx --test --test-force-exit src/autostart.test.ts src/log.test.ts src/dialogs.test.ts src/settings.test.ts src/updater.test.ts"
  },
  "description": "UniChat desktop app (Electron)",
  "author": "UniChat",
  "homepage": "https://github.com/PixelcrafterEXE/unichat",
  "desktopName": "unichat.desktop"
}
